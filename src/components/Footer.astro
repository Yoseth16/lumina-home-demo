---
import Logo from './Logo.astro';
import { site } from '../data/site';
import { categories } from '../data/catalog';
import { buildWhatsAppUrl, quoteMessage } from '../lib/whatsapp';
---
<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <Logo variant="lockup" />
    </div>
    <nav class="footer-block" aria-label="Catálogo">
      <h2 class="footer-title">Catálogo</h2>
      <ul class="footer-links">
        {
          categories.map((category) => (
            <li>
              <a href={`/catalogo/${category.slug}/`}>{category.shortName}</a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="footer-block">
      <h2 class="footer-title">Contacto</h2>
      <ul class="footer-links">
        <li>
          <a
            class="footer-wa"
            href={buildWhatsAppUrl({ number: site.whatsappNumber, message: quoteMessage({}) })}
            target="_blank"
            rel="noopener noreferrer"
          >
            Escríbenos por WhatsApp
          </a>
        </li>
        <li>{site.city}</li>
        {site.email && <li>{site.email}</li>}
        {site.address && <li>{site.address}</li>}
        {
          site.whatsappNumber === null && (
            <li class="wa-notice">Número de WhatsApp pendiente de confirmar (demostración)</li>
          )
        }
      </ul>
    </div>
  </div>
  <div class="container footer-bottom">
    <p>© Lumina Home</p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-navy-900);
    color: var(--color-ivory);
  }

  .site-footer :global(.logo) {
    color: var(--color-ivory);
  }

  .site-footer :global(a:focus-visible) {
    outline-color: var(--color-ivory);
  }

  .footer-grid {
    display: grid;
    gap: var(--space-6);
    padding-block: var(--space-8) var(--space-6);
  }

  .footer-brand {
    display: flex;
    align-items: center;
  }

  .footer-title {
    margin-bottom: var(--space-3);
    font-size: var(--fs-2);
    color: var(--color-cream);
  }

  .footer-links {
    display: grid;
    gap: var(--space-2);
    padding: 0;
    list-style: none;
  }

  .footer-links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    text-decoration: none;
  }

  .footer-links a:hover {
    text-decoration: underline;
  }

  .wa-notice {
    color: var(--color-beige);
  }

  .footer-bottom {
    padding-block: var(--space-4);
    border-top: 1px solid var(--color-line);
    font-size: var(--fs-0);
  }

  @media (min-width: 860px) {
    .footer-grid {
      grid-template-columns: 1.25fr 1fr 1fr;
      align-items: start;
    }
  }
</style>
