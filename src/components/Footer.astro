---
import Logo from './Logo.astro';
import { site } from '../data/site';
import { categories } from '../data/catalog';
import { buildWhatsAppUrl, quoteMessage } from '../lib/whatsapp';

/* T13 (ítem 6): enlaces de las 2 fichas completas derivados del
   catálogo (cero URLs de producto escritas a mano). */
const fichaItems = categories.flatMap((category) =>
  category.items
    .filter((item) => item.status === 'ficha')
    .map((item) => ({ name: item.name, href: `/catalogo/${category.slug}/${item.slug}/` })),
);
---
<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <Logo variant="lockup" />
    </div>
    <nav class="footer-block" aria-label="Catálogo">
      <h2 class="footer-title">Catálogo</h2>
      <ul class="footer-links">
        {
          categories.map((category) => (
            <li>
              <a href={`/catalogo/${category.slug}/`}>{category.shortName}</a>
            </li>
          ))
        }
        {
          fichaItems.map((item) => (
            <li>
              <a href={item.href}>{item.name}</a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="footer-block">
      <h2 class="footer-title">Contacto</h2>
      <ul class="footer-links">
        <li>
          <a
            class="footer-wa"
            href={buildWhatsAppUrl({ number: site.whatsappNumber, message: quoteMessage({}) })}
            target="_blank"
            rel="noopener noreferrer"
          >
            Escríbenos por WhatsApp
          </a>
        </li>
        {/* T13 (ítem 6): enlace a la página de contacto además del canal
            de WhatsApp */}
        <li><a href="/contacto/">Formulario de contacto</a></li>
        <li>{site.city}</li>
        {site.email && <li>{site.email}</li>}
        {site.address && <li>{site.address}</li>}
        {
          site.whatsappNumber === null && (
            <li class="wa-notice">Número de WhatsApp pendiente de confirmar (demostración)</li>
          )
        }
      </ul>
    </div>
  </div>
  <div class="container footer-bottom">
    <p>© Lumina Home</p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-navy-900);
    color: var(--color-ivory);
  }

  .site-footer :global(.logo) {
    color: var(--color-ivory);
  }

  .site-footer :global(a:focus-visible) {
    outline-color: var(--color-ivory);
  }

  /* T11a (ítem 1): con el botón flotante visible, el pie gana espacio
     inferior para que su última línea nunca quede cubierta (WCAG
     2.4.11); el resto del padding del pie se mantiene. */
  :global(.has-fab) .site-footer {
    padding-block-end: calc(80px + env(safe-area-inset-bottom));
  }

  .footer-grid {
    display: grid;
    gap: var(--space-6);
    padding-block: var(--space-8) var(--space-6);
  }

  .footer-brand {
    display: flex;
    align-items: center;
  }

  .footer-title {
    margin-bottom: var(--space-3);
    font-size: var(--fs-2);
    color: var(--color-cream);
  }

  .footer-links {
    display: grid;
    gap: var(--space-2);
    padding: 0;
    list-style: none;
  }

  .footer-links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    text-decoration: none;
  }

  /* T11a (ítem 9): subrayado solo con puntero fino */
  @media (hover: hover) and (pointer: fine) {
    .footer-links a:hover {
      text-decoration: underline;
    }
  }

  .wa-notice {
    color: var(--color-beige);
  }

  .footer-bottom {
    padding-block: var(--space-4);
    border-top: 1px solid var(--color-line);
    font-size: var(--fs-0);
  }

  @media (min-width: 860px) {
    .footer-grid {
      grid-template-columns: 1.25fr 1fr 1fr;
      align-items: start;
    }
  }
</style>
