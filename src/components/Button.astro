---
interface Props {
  variant?: 'primary' | 'secondary' | 'ghost' | 'on-dark' | 'on-dark-outline';
  href?: string;
  type?: 'button' | 'submit';
  external?: boolean;
}

const { variant = 'primary', href, type = 'button', external = false } = Astro.props;

const classes = ['btn', `btn-${variant}`].join(' ');
---

{
  href !== undefined ? (
    <a
      class={classes}
      href={href}
      target={external ? '_blank' : undefined}
      rel={external ? 'noopener noreferrer' : undefined}
    >
      <slot />
    </a>
  ) : (
    <button class={classes} type={type}>
      <slot />
    </button>
  )
}

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    min-height: 44px;
    padding: var(--space-2) var(--space-5);
    border: 1px solid transparent;
    border-radius: var(--radius-sm);
    font-family: inherit;
    font-size: var(--fs-0);
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
    /* T11a (ítem 9): retroalimentación de pulsación (transición
       explícita de dos propiedades, nunca genérica) */
    transition:
      transform 120ms var(--ease),
      background-color 150ms ease;
  }

  .btn:active {
    transform: scale(0.97);
  }

  @media (prefers-reduced-motion: reduce) {
    .btn:active {
      transform: none;
    }
  }

  .btn-primary {
    background: var(--color-navy-800);
    color: var(--color-ivory);
  }

  /* T11a (ítem 9): hovers solo para punteros finos */
  @media (hover: hover) and (pointer: fine) {
    .btn-primary:hover {
      background: var(--color-navy-600);
    }

    .btn-secondary:hover {
      background: var(--color-cream);
    }

    .btn-ghost:hover {
      background: var(--color-cream);
    }

    .btn-on-dark:hover {
      background: var(--color-cream);
    }

    .btn-on-dark-outline:hover {
      background: color-mix(in srgb, var(--color-ivory) 14%, transparent);
    }
  }

  .btn-secondary {
    background: transparent;
    border-color: var(--color-navy-800);
    color: var(--color-navy-800);
  }

  .btn-ghost {
    background: transparent;
    color: var(--color-navy-800);
  }

  /* FX-01: sobre fondos azul marino (navy-900) el relleno azul marino no
     se lee como botón. `on-dark` = relleno marfil con texto azul marino;
     `on-dark-outline` = contorno marfil. Contraste texto/fondo >= 4.5:1
     en reposo y en hover (marfil/navy 16.35:1, navy/crema 14.51:1). */
  .btn-on-dark {
    background: var(--color-ivory);
    color: var(--color-navy-900);
  }

  .btn-on-dark-outline {
    background: transparent;
    border-color: var(--color-ivory);
    color: var(--color-ivory);
  }
</style>
