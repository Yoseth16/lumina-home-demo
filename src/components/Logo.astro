---
// vectorización provisional — pendiente de aprobación del cliente
import markSvg from '../assets/brand/logo-mark.svg?raw';
import wordmarkSvg from '../assets/brand/logo-wordmark.svg?raw';
import lockupSvg from '../assets/brand/logo-lockup.svg?raw';

interface Props {
  variant?: 'header' | 'lockup';
}

const { variant = 'header' } = Astro.props;
---

{
  variant === 'lockup' ? (
    <span class="logo logo-lockup" role="img" aria-label="Lumina Home">
      <Fragment set:html={lockupSvg} />
    </span>
  ) : (
    <span class="logo logo-header" role="img" aria-label="Lumina Home">
      <Fragment set:html={markSvg} />
      <Fragment set:html={wordmarkSvg} />
    </span>
  )
}

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
  }

  /* Tamaño por altura CSS; ancho automático según el viewBox. */
  .logo :global(svg) {
    height: 2.75rem;
    width: auto;
  }

  .logo-header :global(svg + svg) {
    height: 1.375rem;
  }

  .logo-lockup :global(svg) {
    height: 6rem;
  }
</style>
