---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Button from './Button.astro';
import { mediaRegistry } from '../data/media';
import { site } from '../data/site';
import type { Category, Item } from '../data/schema';
import { buildWhatsAppUrl, quoteMessage } from '../lib/whatsapp';
import { publicAssetUrl, withBase } from '../lib/paths';

/**
 * Tarjeta de producto del catálogo. T11b (ítem 4): los ítems `ficha`
 * siguen siendo una `<article>` completa que enlaza a su página de
 * producto; los `pendiente` se muestran ahora como FILA COMPACTA
 * (`.item-row`, sin imagen ni descripción): nombre, píldora de ficha en
 * preparación y enlace «Cotizar <nombre>». Sin imágenes ni texto
 * inventado: el contenido siempre proviene de `catalog.ts` y `media.ts`.
 *
 * FX-11: las tarjetas `ficha` derivan su miniatura del PRIMER id de
 * `item.media` a través del registro (imagen -> mecanismo de imágenes del
 * proyecto; vídeo -> su póster) y toda la tarjeta es un único enlace cuyo
 * texto incluye el nombre; sin enlaces anidados. Los `pendiente` no
 * llevan imagen ni enlace a ficha.
 */
interface Props {
  category: Category;
  item: Item;
}

const { category, item } = Astro.props;

const isFicha = item.status === 'ficha';
/* T14: la ruta del producto lleva la base del despliegue (GitHub Pages
   en subdirectorio). */
const productHref = withBase(`/catalogo/${category.slug}/${item.slug}/`);

/* T11b (ítem 4): enlace de cotización de la fila compacta, calculado
   siempre (número y texto via helpers, igual que WhatsAppButton). */
const quoteHref = buildWhatsAppUrl({
  number: site.whatsappNumber,
  message: quoteMessage({ item: { name: item.name }, category: { name: category.name } }),
});

/** Imágenes del proyecto indexadas por la ruta `file` del registro (prefijo `/`). */
const imageSources = import.meta.glob('/src/assets/**/*.{jpeg,jpg,png}', {
  eager: true,
  import: 'default',
}) as Record<string, ImageMetadata>;

let thumbImageSource: ImageMetadata | undefined;
let thumbPosterSrc: string | undefined;

if (isFicha) {
  const firstMediaId = item.media?.[0];
  const entry =
    firstMediaId === undefined
      ? undefined
      : mediaRegistry.find((candidate) => candidate.id === firstMediaId);
  const rawPath = entry === undefined ? undefined : entry.kind === 'video' ? entry.poster : entry.file;

  // Defensivo (única rama no ejercitada por la build real): un id de medio
  // no registrado, o sin archivo/póster, interrumpe el build como VideoSlot.
  if (entry === undefined || rawPath === undefined) {
    throw new Error(
      `ItemCard: miniatura no disponible para el ítem de ficha "${item.slug}" (medio: ${firstMediaId ?? 'sin medios'}).`,
    );
  }

  if (entry.kind === 'video') {
    thumbPosterSrc = publicAssetUrl(rawPath);
  } else {
    thumbImageSource = imageSources[`/${rawPath}`];
  }
}

/* Miniatura optimizada con el mecanismo de imágenes del proyecto
   (`getImage`, la misma API sobre la que se construye `Image`): el
   `<img>` final se emite aquí con `alt=""` literal para que sea
   decorativo (el nombre de la tarjeta es el texto del enlace). */
const thumbImageSizes = '(min-width: 1000px) 350px, (min-width: 640px) 45vw, calc(100vw - 32px)';
const thumbImage =
  thumbImageSource !== undefined
    ? await getImage({
        src: thumbImageSource,
        widths: [360, 720],
        sizes: thumbImageSizes,
        alt: '',
      })
    : undefined;
---

{
  isFicha ? (
    <article class="item-card item-card--ficha">
      {thumbImage !== undefined && (
        <img
          class="item-thumb"
          src={thumbImage.src}
          srcset={thumbImage.srcSet.attribute}
          sizes={thumbImageSizes}
          alt=""
          aria-hidden="true"
          loading="lazy"
          decoding="async"
        />
      )}
      {thumbPosterSrc !== undefined && (
        <img class="item-thumb" src={thumbPosterSrc} alt="" aria-hidden="true" loading="lazy" />
      )}
      <h3 class="item-name">
        <a class="item-link" href={productHref}>
          {item.name}
          <span class="item-link-hint" aria-hidden="true">Ver ficha</span>
        </a>
      </h3>
      {item.summary !== undefined && <p class="item-summary">{item.summary}</p>}
    </article>
  ) : (
    <div class="item-row">
      <span class="item-row-name">{item.name}</span>
      <span class="item-badge">Ficha en preparación</span>
      <Button variant="link" href={quoteHref} external>
        Cotizar<span class="visually-hidden"> {item.name}</span>
      </Button>
    </div>
  )
}

<style>
  .item-card {
    display: grid;
    gap: var(--space-3);
    align-content: start;
    padding: var(--space-5) var(--space-4);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    background: var(--color-cream);
  }

  /* FX-11: el único enlace de la tarjeta se estira sobre toda la
     superficie (pseudo-elemento) manteniendo el texto del nombre. */
  .item-card--ficha {
    position: relative;
  }

  /* T11a (ítem 9): el borde al enfocar con teclado va fuera de la media
     query de hover; el hover, dentro (una lista con `:has()` no
     soportada invalidaría la regla completa). */
  .item-card--ficha:has(.item-link:focus-visible) {
    border-color: var(--color-sand-600);
  }

  @media (hover: hover) and (pointer: fine) {
    .item-card--ficha:hover {
      border-color: var(--color-sand-600);
    }
  }

  /* T8B (F-2): anillo solo con foco de teclado (:focus-visible del
     enlace, leído con :has()); el clic de ratón ya no lo dibuja. El
     anillo propio del enlace (regla global a:focus-visible) se
     conserva como respaldo en navegadores sin :has(). */
  .item-card--ficha:has(.item-link:focus-visible) {
    outline: 3px solid var(--color-navy-800);
    outline-offset: 2px;
  }

  .item-thumb {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius-md);
  }

  .item-name {
    color: var(--color-navy-800);
  }

  .item-summary {
    color: var(--color-muted);
  }

  /* FX-12: aviso en píldora pequeña, sentence case (sin mayúsculas
     forzadas ni caja a todo el ancho); el texto se mantiene literal. */
  .item-badge {
    justify-self: start;
    align-self: start;
    padding: var(--space-1) var(--space-3);
    border: 1px solid var(--color-line);
    border-radius: 999px;
    font-size: var(--fs-0);
    font-weight: 600;
    color: var(--color-muted);
  }

  .item-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    font-weight: 600;
    color: var(--color-navy-800);
    text-decoration: none;
  }

  .item-link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  /* T11a (ítem 9): subrayado solo con puntero fino */
  @media (hover: hover) and (pointer: fine) {
    .item-link:hover {
      text-decoration: underline;
    }
  }

  .item-link-hint {
    font-size: var(--fs-0);
    font-weight: 600;
    color: var(--color-muted);
  }

  /* T11b (ítem 4): fila compacta del ítem pendiente (sin artículo ni
     encabezado): nombre, píldora y enlace de cotización en una línea
     que envuelve sin desbordar a 320 px. */
  .item-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-4);
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    background: var(--color-cream);
  }

  .item-row-name {
    flex: 1 1 14ch;
    font-weight: 600;
    color: var(--color-navy-800);
    overflow-wrap: anywhere;
  }
</style>
