---
import Logo from './Logo.astro';
import Button from './Button.astro';
import { site } from '../data/site';
import { categories } from '../data/catalog';
import { buildWhatsAppUrl, quoteMessage } from '../lib/whatsapp';
import { withBase } from '../lib/paths';
---
<header class="site-header">
  <div class="container header-inner">
    <a class="brand-link" href={withBase('/')} aria-label="Lumina Home, ir al inicio">
      <Logo variant="header" />
    </a>
    <button type="button" class="nav-toggle" aria-expanded="false" aria-controls="nav-principal">
      Menú
    </button>
    <nav id="nav-principal" class="site-nav" aria-label="Principal">
      <ul class="nav-list">
        <li>
          <a href={withBase('/')}>Inicio</a>
        </li>
        <li class="has-submenu">
          <a href={withBase('/catalogo/')}>Catálogo<svg class="nav-chevron" aria-hidden="true" focusable="false" width="12" height="12" viewBox="0 0 12 12"><path d="M2 4l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg></a>
          <ul class="nav-sublist">
            {
              categories.map((category) => (
                <li>
                  <a href={withBase(`/catalogo/${category.slug}/`)}>{category.shortName}</a>
                </li>
              ))
            }
          </ul>
        </li>
        <li>
          <a href={withBase('/contacto/')}>Contacto</a>
        </li>
      </ul>
      <div class="header-cta">
        <Button
          variant="on-dark"
          href={buildWhatsAppUrl({ number: site.whatsappNumber, message: quoteMessage({}) })}
          external
        >
          Cotizar por WhatsApp<span class="visually-hidden"> desde el encabezado</span>
        </Button>
      </div>
    </nav>
  </div>
</header>

<script>
  import '../scripts/menu.ts';
</script>

<style>
  .site-header {
    /* T13 (ítem 5): cabecera fija sutil; el submenú (31) y el FAB (50)
       quedan por encima. */
    position: sticky;
    top: 0;
    z-index: 30;
    background: var(--color-navy-900);
    color: var(--color-ivory);
  }

  .header-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    padding-block: var(--space-3);
  }

  .brand-link {
    margin-right: auto;
    text-decoration: none;
  }

  .brand-link :global(.logo) {
    color: var(--color-ivory);
  }

  /* Enfoque visible con alto contraste sobre el fondo azul marino */
  .site-header :global(a:focus-visible),
  .site-header :global(button:focus-visible) {
    outline-color: var(--color-ivory);
  }

  .nav-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: var(--space-2) var(--space-4);
    background: transparent;
    border: 1px solid var(--color-cream);
    border-radius: var(--radius-sm);
    color: var(--color-ivory);
    font-size: var(--fs-0);
    cursor: pointer;
  }

  .site-nav {
    flex-basis: 100%;
  }

  /* El menú solo se pliega cuando JS está activo (html.js);
     sin JavaScript queda visible y utilizable. */
  @media (max-width: 859px) {
    :global(html.js) .site-nav:not(.is-open) {
      display: none;
    }

    /* T13 (ítem 5): en ventanas bajas el menú abierto no atrapa los
       enlaces: se limita a la altura visible y se deja desplazar. */
    .site-nav.is-open {
      max-height: calc(100dvh - 72px);
      overflow-y: auto;
    }
  }

  .nav-list {
    display: grid;
    gap: var(--space-1);
    padding: 0;
    list-style: none;
  }

  .site-nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    text-decoration: none;
  }

  /* T11a (ítem 9): subrayado solo con puntero fino */
  @media (hover: hover) and (pointer: fine) {
    .site-nav a:hover {
      text-decoration: underline;
    }
  }

  /* Submenú de categorías: expandido en móvil */
  .nav-sublist {
    display: grid;
    gap: var(--space-1);
    padding: 0 0 0 var(--space-4);
    list-style: none;
  }

  /* T11b (ítem 11): chevrona del submenú, oculta en móvil (el submenú
     va expandido y no aporta); visible solo en escritorio. */
  .nav-chevron {
    display: none;
  }

  .header-cta {
    margin-top: var(--space-3);
  }

  /* Escritorio: navegación horizontal en una fila */
  @media (min-width: 860px) {
    .header-inner {
      flex-wrap: nowrap;
    }

    .nav-toggle {
      display: none;
    }

    .site-nav {
      display: flex;
      flex-basis: auto;
      align-items: center;
      gap: var(--space-5);
    }

    .nav-list {
      display: flex;
      align-items: center;
      gap: var(--space-5);
    }

    .nav-sublist {
      position: absolute;
      top: 100%;
      left: 0;
      display: none;
      /* T11b-FIX1 (D2) + T13 (ítem 5): el desplegable se pinta sobre la
         cabecera fija y el héroe de la portada (por debajo del FAB, 50,
         y del skip-link, 100). */
      z-index: 31;
      min-width: 220px;
      padding: var(--space-3);
      background: var(--color-navy-800);
      border: 1px solid var(--color-line);
      border-radius: var(--radius-sm);
      box-shadow: var(--shadow-soft);
    }

    .has-submenu {
      position: relative;
    }

    /* Submenú revelado al enfocar dentro (teclado) y, solo con puntero
       fino, al pasar el puntero (T11a, ítem 9). */
    .has-submenu:focus-within .nav-sublist {
      display: grid;
    }

    /* T11b (ítem 11): en escritorio la chevrona acompaña al texto del
       enlace «Catálogo» y gira al abrirse el submenú (foco dentro y,
       solo con puntero fino, hover), sin transición ni animación. */
    .nav-chevron {
      display: block;
    }

    .has-submenu > a {
      gap: var(--space-1);
    }

    .has-submenu:focus-within .nav-chevron {
      transform: rotate(180deg);
    }

    @media (hover: hover) and (pointer: fine) {
      .has-submenu:hover .nav-sublist {
        display: grid;
      }

      .has-submenu:hover .nav-chevron {
        transform: rotate(180deg);
      }
    }

    .header-cta {
      margin-top: 0;
    }
  }
</style>
