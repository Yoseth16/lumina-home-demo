---
import { withBase } from '../lib/paths';

/**
 * Ruta de navegación (migas de pan). Todos los elementos menos el último
 * son enlaces; el último marca la página actual con `aria-current="page"`.
 * El separador visual queda oculto a lectores de pantalla.
 *
 * T14: los enlaces de las migas se resuelven aquí con la base del
 * despliegue (`withBase`), sin ternarios en la plantilla: el elemento
 * actual es un `span` y el resto un enlace prefijado.
 */
interface BreadcrumbItem {
  label: string;
  href?: string;
}

interface Props {
  items: BreadcrumbItem[];
}

type ResolvedCrumb = { label: string; isCurrent: true } | { label: string; isCurrent: false; href: string };

function resolveCrumb(item: BreadcrumbItem, isCurrent: boolean): ResolvedCrumb {
  if (isCurrent) {
    return { label: item.label, isCurrent: true };
  }
  // Defensivo (única rama no ejercitada por la build real, G13): las
  // migas no actuales siempre llegan con `href`.
  if (item.href === undefined) {
    throw new Error(`Breadcrumbs: la miga no actual «${item.label}» necesita href.`);
  }
  return { label: item.label, isCurrent: false, href: withBase(item.href) };
}

const { items } = Astro.props;

const crumbs = items.map((item, index) => resolveCrumb(item, index === items.length - 1));
---

<nav aria-label="Ruta de navegación">
  <ol class="breadcrumbs">
    {
      crumbs.map((crumb) => (
        <li class="crumb">
          {crumb.isCurrent && (
            <span class="crumb-label" aria-current="page">
              {crumb.label}
            </span>
          )}
          {!crumb.isCurrent && (
            <>
              <a class="crumb-link" href={crumb.href}>
                {crumb.label}
              </a>
              <span class="crumb-separator" aria-hidden="true">›</span>
            </>
          )}
        </li>
      ))
    }
  </ol>
</nav>

<style>
  .breadcrumbs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    padding: 0;
    list-style: none;
    font-size: var(--fs-0);
  }

  .crumb {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .crumb-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    text-decoration: none;
  }

  /* T11a (ítem 9): subrayado solo con puntero fino */
  @media (hover: hover) and (pointer: fine) {
    .crumb-link:hover {
      text-decoration: underline;
    }
  }

  /* Decorativo, oculto a lectores de pantalla (aria-hidden) */
  .crumb-separator {
    opacity: 0.65;
  }
</style>
