---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Button from '../components/Button.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { categories } from '../data/catalog';
import { site } from '../data/site';

/**
 * Página de contacto. El formulario de cotización es la versión con
 * JavaScript; sin JavaScript se muestra el enlace directo de WhatsApp
 * (mejora progresiva: el formulario se oculta con CSS hasta que el
 * script añade la clase `js` a <html>). Las opciones del selector se
 * alimentan del catálogo: una por ítem, agrupadas por categoría.
 */
const crumbs = [
  { label: 'Inicio', href: '/' },
  { label: 'Contacto' },
];

const hasWhatsAppNumber = site.whatsappNumber !== null;
---

<BaseLayout
  title="Contacto — Lumina Home"
  description="Solicita tu cotización por WhatsApp: elige el producto y cuéntanos qué necesitas."
>
  <section class="contact-hero">
    <div class="container">
      <Breadcrumbs items={crumbs} />
      <h1 class="contact-title">Contacto</h1>
      <p class="contact-lead">Cuéntanos qué necesitas y solicita tu cotización por WhatsApp.</p>
      {!hasWhatsAppNumber && (
        <p class="wa-pending">Número de WhatsApp pendiente de confirmar (demostración).</p>
      )}
    </div>
  </section>

  <section class="contact-form-section" data-reveal>
    <div class="container">
      <div class="js-only">
        <form class="quote-form" data-quote-form novalidate data-wa-number={site.whatsappNumber ?? ''}>
          <div class="field">
            <label for="nombre">Nombre</label>
            <input
              id="nombre"
              name="nombre"
              type="text"
              autocomplete="name"
              required
              aria-describedby="nombre-error"
            />
            <p class="field-error" id="nombre-error" aria-live="polite"></p>
          </div>

          <div class="field">
            <label for="service">Producto</label>
            <select id="service" name="service" required aria-describedby="service-error">
              <option value="" disabled selected>Selecciona un producto</option>
              {
                categories.map((category) => (
                  <optgroup label={category.name}>
                    {category.items.map((item) => (
                      <option
                        value={`${category.slug}/${item.slug}`}
                        data-item={item.name}
                        data-category={category.name}
                      >
                        {item.name}
                      </option>
                    ))}
                  </optgroup>
                ))
              }
            </select>
            <p class="field-error" id="service-error" aria-live="polite"></p>
          </div>

          <div class="field">
            <label for="message">Mensaje (opcional)</label>
            <textarea id="message" name="message" rows="4"></textarea>
          </div>

          <Button type="submit" variant="primary">Enviar por WhatsApp</Button>
        </form>
      </div>

      <div class="no-js-only">
        <WhatsAppButton label="Escríbenos por WhatsApp" />
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import '../scripts/quote-form.ts';
</script>

<style>
  /* Banda de encabezado: azul marino con texto marfil */
  .contact-hero {
    padding-block: var(--space-5) var(--space-6);
    background: var(--color-navy-900);
    color: var(--color-ivory);
  }

  .contact-hero :global(a:focus-visible) {
    outline-color: var(--color-ivory);
  }

  .contact-title {
    margin-block: var(--space-3) var(--space-2);
    color: var(--color-ivory);
  }

  .contact-lead {
    max-width: 52ch;
    color: var(--color-cream);
  }

  .wa-pending {
    align-self: start;
    margin-top: var(--space-4);
    padding: var(--space-1) var(--space-2);
    border: 1px solid var(--color-beige);
    border-radius: var(--radius-sm);
    font-size: var(--fs-0);
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--color-cream);
  }

  /* Formulario sobre fondo claro: el botón primario nunca va sobre azul */
  .contact-form-section {
    padding-block: var(--space-6) var(--space-8);
  }

  /* Mejora progresiva: sin JavaScript, formulario fuera y enlace dentro */
  :global(html:not(.js)) .js-only {
    display: none;
  }

  :global(html.js) .no-js-only {
    display: none;
  }

  .quote-form {
    display: grid;
    gap: var(--space-5);
    max-width: 560px;
    padding: var(--space-5) var(--space-4);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    background: var(--color-cream);
  }

  .field {
    display: grid;
    gap: var(--space-2);
  }

  .field label {
    font-weight: 600;
    color: var(--color-navy-800);
  }

  .field input,
  .field select,
  .field textarea {
    width: 100%;
    min-height: 44px;
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--color-beige);
    border-radius: var(--radius-sm);
    background: var(--color-ivory);
    color: var(--color-ink);
  }

  .field textarea {
    resize: vertical;
  }

  .field-error {
    min-height: 1.4em;
    font-size: var(--fs-0);
    font-weight: 600;
    color: var(--color-ink);
  }

  .no-js-only {
    display: flex;
  }
</style>
