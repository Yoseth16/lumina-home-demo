---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Button from '../components/Button.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { categories } from '../data/catalog';
import { site } from '../data/site';

/**
 * Página de contacto. El formulario de cotización es la versión con
 * JavaScript; sin JavaScript se muestra el enlace directo de WhatsApp
 * (mejora progresiva: el formulario se oculta con CSS hasta que el
 * script añade la clase `js` a <html>). Las opciones del selector se
 * alimentan del catálogo: una por ítem, agrupadas por categoría.
 */
const crumbs = [
  { label: 'Inicio', href: '/' },
  { label: 'Contacto' },
];

const hasWhatsAppNumber = site.whatsappNumber !== null;
---

<BaseLayout
  title="Contacto — Lumina Home"
  description="Solicita tu cotización por WhatsApp: elige el producto y cuéntanos qué necesitas."
>
  <section class="contact-hero">
    <div class="container">
      <Breadcrumbs items={crumbs} />
      <h1 class="contact-title">Contacto</h1>
      <p class="contact-lead">Cuéntanos qué necesitas y solicita tu cotización por WhatsApp.</p>
      {!hasWhatsAppNumber && (
        <p class="wa-pending">Número de WhatsApp pendiente de confirmar (demostración).</p>
      )}
    </div>
  </section>

  <section class="contact-form-section" data-reveal>
    <div class="container">
      {/* T13 (ítem 3): dos columnas en escritorio — formulario a la
          izquierda, guía «Cómo cotizar» a la derecha. */}
      <div class="contact-layout">
        <div class="contact-main">
          <div class="js-only">
            <form class="quote-form" data-quote-form novalidate data-wa-number={site.whatsappNumber ?? ''}>
              <div class="field">
                <label for="nombre">Nombre</label>
                <input
                  id="nombre"
                  name="nombre"
                  type="text"
                  autocomplete="name"
                  required
                  aria-describedby="nombre-error"
                />
                <p class="field-error" id="nombre-error" aria-live="polite"></p>
              </div>

              <div class="field">
                <label for="service">Producto</label>
                <select id="service" name="service" required aria-describedby="service-error">
                  <option value="" disabled selected>Selecciona un producto</option>
                  {
                    categories.map((category) => (
                      <optgroup label={category.name}>
                        {category.items.map((item) => (
                          <option
                            value={`${category.slug}/${item.slug}`}
                            data-item={item.name}
                            data-category={category.name}
                          >
                            {item.name}
                          </option>
                        ))}
                      </optgroup>
                    ))
                  }
                </select>
                <p class="field-error" id="service-error" aria-live="polite"></p>
              </div>

              <div class="field">
                <label for="message">Mensaje (opcional)</label>
                {/* T13 (ítem 3): ejemplo de uso dentro del área de texto */}
                <textarea
                  id="message"
                  name="message"
                  rows="4"
                  placeholder="Medidas aproximadas o tipo de espacio"
                ></textarea>
              </div>

              <Button type="submit" variant="primary">Enviar por WhatsApp</Button>
            </form>
          </div>

          <div class="no-js-only">
            <WhatsAppButton label="Escríbenos por WhatsApp" context=" desde el formulario de contacto" />
          </div>
        </div>

        {/* T13 (ítem 3): mismos pasos provisionales de la portada, sin
            inventar horarios, dirección ni teléfono. */}
        <aside class="contact-aside" aria-labelledby="contacto-como-cotizar">
          <h2 id="contacto-como-cotizar">Cómo cotizar</h2>
          <ol class="contact-steps" role="list">
            <li class="step">
              <span class="step-number" aria-hidden="true">1</span>
              <span class="step-text">Elige el producto en el catálogo.</span>
            </li>
            <li class="step">
              <span class="step-number" aria-hidden="true">2</span>
              <span class="step-text">Escríbenos por WhatsApp con el producto y las medidas de tu espacio.</span>
            </li>
            <li class="step">
              <span class="step-number" aria-hidden="true">3</span>
              <span class="step-text">Recibe tu cotización por el mismo chat.</span>
            </li>
          </ol>
          <p class="contact-city">{site.city}</p>
        </aside>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import '../scripts/quote-form.ts';
</script>

<style>
  /* Banda de encabezado: azul marino con texto marfil */
  .contact-hero {
    padding-block: var(--space-6) var(--space-7);
    background: var(--color-navy-900);
    color: var(--color-ivory);
  }

  .contact-hero :global(a:focus-visible) {
    outline-color: var(--color-ivory);
  }

  .contact-title {
    margin-block: var(--space-3) var(--space-2);
    color: var(--color-ivory);
  }

  .contact-lead {
    max-width: 52ch;
    color: var(--color-cream);
  }

  .wa-pending {
    align-self: start;
    margin-top: var(--space-4);
    padding: var(--space-1) var(--space-2);
    border: 1px solid var(--color-beige);
    border-radius: var(--radius-sm);
    font-size: var(--fs-0);
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--color-cream);
  }

  /* Formulario sobre fondo claro: el botón primario nunca va sobre azul */
  .contact-form-section {
    padding-block: var(--space-6) var(--space-8);
  }

  /* Mejora progresiva: sin JavaScript, formulario fuera y enlace dentro */
  :global(html:not(.js)) .js-only {
    display: none;
  }

  :global(html.js) .no-js-only {
    display: none;
  }

  /* T13 (ítem 3): rejilla de dos columnas — una en móvil, formulario y
     guía a partir de 900 px. */
  .contact-layout {
    display: grid;
    gap: var(--space-6);
  }

  @media (min-width: 900px) {
    .contact-layout {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
      gap: var(--space-7);
      align-items: start;
    }
  }

  .quote-form {
    display: grid;
    gap: var(--space-5);
    width: 100%;
    max-width: 560px;
    padding: var(--space-5) var(--space-4);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    background: var(--color-cream);
  }

  .field {
    display: grid;
    gap: var(--space-2);
  }

  .field label {
    font-weight: 600;
    color: var(--color-navy-800);
  }

  .field input,
  .field select,
  .field textarea {
    width: 100%;
    min-height: 44px;
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--color-beige);
    border-radius: var(--radius-sm);
    background: var(--color-ivory);
    color: var(--color-ink);
  }

  .field textarea {
    resize: vertical;
  }

  /* T13 (ítem 3): error con contraste 6.76:1 sobre crema (#F1E9DC) */
  .field-error {
    min-height: 1.4em;
    font-size: var(--fs-0);
    font-weight: 600;
    color: #9b1c1c;
  }

  .field input[aria-invalid='true'],
  .field select[aria-invalid='true'] {
    border-color: #9b1c1c;
  }

  /* T13 (ítem 3): guía lateral con los mismos pasos numerados de la
     portada (círculo azul marino, texto marfil). */
  .contact-aside {
    display: grid;
    gap: var(--space-4);
    align-content: start;
  }

  .contact-aside h2 {
    color: var(--color-navy-800);
  }

  .contact-steps {
    display: grid;
    gap: var(--space-4);
    padding: 0;
    margin-bottom: 0;
    list-style: none;
  }

  .step {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
  }

  .step-number {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    width: 32px;
    height: 32px;
    border-radius: 999px;
    background: var(--color-navy-800);
    color: var(--color-ivory);
    font-weight: 600;
  }

  .step-text {
    padding-block: var(--space-1);
  }

  .contact-city {
    font-size: var(--fs-0);
    font-weight: 600;
    color: var(--color-muted);
  }

  .no-js-only {
    display: flex;
  }
</style>
