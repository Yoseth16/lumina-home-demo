---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import CategoryCard from '../components/CategoryCard.astro';
import FeatureList from '../components/FeatureList.astro';
import MediaSlot from '../components/MediaSlot.astro';
import SectionHeading from '../components/SectionHeading.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { categories } from '../data/catalog';

const benefits = [
  {
    title: 'Privacidad',
    text: 'Productos pensados para conservar la privacidad de tus espacios.',
  },
  {
    title: 'Control de luz y protección solar',
    text: 'Soluciones para graduar la entrada de luz y controlar el sol.',
  },
  {
    title: 'Diseño y decoración',
    text: 'Diseños y texturas que combinan con tu hogar.',
  },
  {
    title: 'Cotización ágil por WhatsApp',
    text: 'Cuéntanos qué necesitas y solicita tu cotización por WhatsApp.',
  },
];
---

<BaseLayout
  title="Lumina Home — El arte de transformar tus espacios"
  description="Disfruta de tus espacios con la iluminación que deseas y un diseño que combina con tu hogar."
>
  <section class="hero" id="inicio" aria-labelledby="hero-title">
    <div class="hero-media" aria-hidden="true">
      <MediaSlot
        id="obra-enrollable-doble-altura"
        widths={[640, 960, 1280, 1600]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
      />
    </div>
    <div class="hero-overlay" aria-hidden="true"></div>
    <div class="container hero-content">
      <h1 id="hero-title">El arte de transformar tus espacios</h1>
      <p class="hero-lead">
        Disfruta de tus espacios con la iluminación que deseas y un diseño que combina con tu hogar.
      </p>
      <div class="hero-actions">
        <Button variant="on-dark-outline" href="/catalogo/">Ver catálogo</Button>
        <WhatsAppButton variant="on-dark" context=" desde la portada" />
      </div>
    </div>
  </section>

  <section class="home-section" id="presentacion" data-reveal>
    <div class="container">
      <div class="presentacion-columns">
        <div class="presentacion-copy">
          <SectionHeading eyebrow="Cali, Colombia" title="Polarizados, papel tapiz y persianas y cortinas" />
        </div>
        <div class="presentacion-media">
          <MediaSlot
            id="brand-mockup"
            widths={[480, 800, 1200]}
            sizes="(min-width: 900px) 55vw, 100vw"
          />
        </div>
      </div>
    </div>
  </section>

  <section class="home-section" id="categorias" data-reveal>
    <div class="container">
      <SectionHeading title="Conoce lo que podemos hacer por tu hogar" />
      <div class="category-grid">
        {categories.map((category) => <CategoryCard category={category} />)}
      </div>
    </div>
  </section>

  <section class="home-section" id="galeria" data-reveal>
    <div class="container">
      <SectionHeading
        title="Galería"
        lead="Fotografías de trabajos de Lumina Home. Las imágenes provisionales se reemplazarán por trabajos reales."
      />
      <div class="gallery-track" tabindex="0" role="region" aria-label="Galería de trabajos">
        <div class="gallery-item">
          <MediaSlot
            id="obra-enrollable-doble-altura"
            widths={[480, 800, 1200]}
            sizes="(min-width: 900px) 33vw, 82vw"
          />
        </div>
        {
          Array.from({ length: 2 }).map(() => (
            <div class="gallery-item">
              <MediaSlot />
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="home-section" id="beneficios" data-reveal>
    <div class="container">
      <SectionHeading title="Lo que encuentras en Lumina Home" />
      <FeatureList items={benefits} />
    </div>
  </section>

  {/* T11b: copy provisional pending client confirmation */}
  <section class="home-section como-cotizar" id="como-cotizar" data-reveal>
    <div class="container">
      <SectionHeading title="Cómo cotizar" />
      <ol class="steps" role="list">
        <li class="step">
          <span class="step-number" aria-hidden="true">1</span>
          <span class="step-text">Elige el producto en el catálogo.</span>
        </li>
        <li class="step">
          <span class="step-number" aria-hidden="true">2</span>
          <span class="step-text">Escríbenos por WhatsApp con el producto y las medidas de tu espacio.</span>
        </li>
        <li class="step">
          <span class="step-number" aria-hidden="true">3</span>
          <span class="step-text">Recibe tu cotización por el mismo chat.</span>
        </li>
      </ol>
    </div>
  </section>

  <section class="cotizar" id="cotizar" data-reveal>
    <div class="container">
      <SectionHeading title="Solicita tu cotización" lead="Cuéntanos qué espacio quieres transformar." />
      <div class="cotizar-actions">
        <WhatsAppButton variant="on-dark" context=" desde la banda de cotización" />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero: foto de obra a sangre completa bajo un velo azul marino que
     deja pasar la luz: en escritorio (>= 768 px) cae de izquierda a
     derecha, denso tras el texto y casi abierto hacia el borde derecho;
     en móvil, ponderado hacia abajo para sostener el texto a todo el
     ancho (T11b, ítem 3). */
  .hero {
    position: relative;
    /* T13 (ítem 7): azul marino de respaldo mientras carga la foto (y
       de fondo permanente si la imagen no llega a renderizarse). */
    background: var(--color-navy-900);
  }

  .hero-media {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .hero-media :global(img),
  .hero-media :global(.media-placeholder) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    aspect-ratio: auto;
  }

  /* T11b (ítem 3): móvil — el texto ocupa todo el ancho, así que el velo
     vertical oscurece sobre todo la parte baja, donde están el título y
     la llamada. */
  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--color-navy-900) 72%, transparent) 0%,
      color-mix(in srgb, var(--color-navy-900) 64%, transparent) 40%,
      color-mix(in srgb, var(--color-navy-900) 86%, transparent) 100%
    );
  }

  /* T11b (ítem 3): escritorio — velo horizontal fuerte tras el titular
     (hasta ~75 % del ancho) que se abre hacia el borde derecho (~25 %
     final sin texto y visiblemente más claro que el velo uniforme
     anterior). */
  @media (min-width: 768px) {
    .hero-overlay {
      background: linear-gradient(
        90deg,
        color-mix(in srgb, var(--color-navy-900) 80%, transparent) 0%,
        color-mix(in srgb, var(--color-navy-900) 72%, transparent) 40%,
        color-mix(in srgb, var(--color-navy-900) 56%, transparent) 65%,
        color-mix(in srgb, var(--color-navy-900) 12%, transparent) 100%
      );
    }
  }

  .hero-content {
    position: relative;
    padding-block: var(--space-8);
    color: var(--color-ivory);
  }

  .hero-content :global(a:focus-visible) {
    outline-color: var(--color-ivory);
  }

  .hero h1 {
    max-width: 20ch;
    font-size: var(--fs-5);
    color: var(--color-ivory);
  }

  .hero-lead {
    max-width: 46ch;
    margin-top: var(--space-4);
    font-size: var(--fs-1);
    color: var(--color-cream);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }

  /* Secciones intermedias */
  .home-section {
    padding-block: var(--space-7) var(--space-8);
  }

  /* T13 (ítem 5): con la cabecera fija, los anclajes bajan su destino
     de desplazamiento para que el título no quede tapado. */
  .home-section[id],
  .cotizar[id] {
    scroll-margin-top: 96px;
  }

  /* Presentación: dos columnas desde 900 px (FX-07): texto a la
     izquierda y mockup de marca a la derecha a tamaño de columna. */
  .presentacion-columns {
    display: grid;
    gap: var(--space-5);
  }

  .presentacion-media {
    max-width: 720px;
    margin-top: var(--space-5);
    padding: var(--space-4);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    background: var(--color-cream);
  }

  .presentacion-media :global(img) {
    width: 100%;
    height: auto;
    object-fit: contain;
  }

  @media (min-width: 900px) {
    .presentacion-columns {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: var(--space-6);
      align-items: center;
    }

    .presentacion-media {
      max-width: none;
      margin-top: 0;
    }
  }

  /* Categorías: una columna en móvil, tres a partir de 900 px */
  .category-grid {
    display: grid;
    gap: var(--space-4);
  }

  @media (min-width: 900px) {
    .category-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* Galería: fila de desplazamiento horizontal en móvil, rejilla en escritorio */
  .gallery-track {
    display: flex;
    gap: var(--space-3);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding-block: var(--space-2);
  }

  .gallery-item {
    flex: 0 0 min(82vw, 360px);
    scroll-snap-align: start;
  }

  .gallery-item :global(img),
  .gallery-item :global(.media-placeholder) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: var(--radius-md);
  }

  .gallery-item :global(img) {
    aspect-ratio: 4 / 3;
  }

  @media (min-width: 900px) {
    .gallery-track {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      overflow-x: visible;
    }

    .gallery-item {
      flex: none;
    }
  }

  /* T11b (ítem 8): «Cómo cotizar» — banda crema de separación con tres
     pasos numerados; una columna en móvil y tres a partir de 900 px.
     Copy provisional pendiente de confirmación del cliente. */
  .como-cotizar {
    padding-block: var(--space-7) var(--space-8);
    background: var(--color-cream);
    color: var(--color-ink);
  }

  .steps {
    display: grid;
    gap: var(--space-4);
    padding: 0;
    margin-bottom: 0;
    list-style: none;
  }

  .step {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
  }

  .step-number {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    width: 32px;
    height: 32px;
    border-radius: 999px;
    background: var(--color-navy-800);
    color: var(--color-ivory);
    font-weight: 600;
  }

  .step-text {
    padding-block: var(--space-1);
  }

  @media (min-width: 900px) {
    .steps {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-5);
    }
  }

  /* Cotizar: banda azul marino */
  .cotizar {
    padding-block: var(--space-8);
    background: var(--color-navy-900);
    color: var(--color-ivory);
  }

  .cotizar :global(.section-heading .title) {
    color: var(--color-ivory);
  }

  .cotizar :global(.section-heading .lead) {
    color: var(--color-cream);
  }

  .cotizar :global(a:focus-visible) {
    outline-color: var(--color-ivory);
  }

  .cotizar-actions {
    margin-top: var(--space-5);
  }
</style>
