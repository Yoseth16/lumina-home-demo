---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import MediaSlot from '../../../components/MediaSlot.astro';
import VideoSlot from '../../../components/VideoSlot.astro';
import WhatsAppButton from '../../../components/WhatsAppButton.astro';
import { fichaItems } from '../../../data/catalog';
import { mediaRegistry } from '../../../data/media';
import type { Category, Item } from '../../../data/schema';

/**
 * Ficha de producto: una página por cada ítem `ficha` del catálogo.
 * El contenido (nombre, descripción confirmada, características y
 * medios) proviene SIEMPRE de `catalog.ts` y `media.ts`; nada se
 * escribe fijo aquí. Las imágenes se renderizan con `MediaSlot` y los
 * vídeos con `VideoSlot`, en el orden de `item.media`.
 */
export function getStaticPaths() {
  return fichaItems().map(({ category, item }) => ({
    params: { categoria: category.slug, producto: item.slug },
    props: { category, item },
  }));
}

interface Props {
  category: Category;
  item: Item;
}

const { category, item } = Astro.props;

if (item.description === undefined) {
  throw new Error(
    `[producto] el ítem de ficha "${item.slug}" no tiene descripción confirmada en el catálogo.`,
  );
}

const description = item.description;

/* T11a (ítem 2): la lista de características se renderiza sin guardia;
   ambos ítems de ficha tienen `features` no vacío (verificado con grep
   en src/data/catalog.ts). Brazo defensivo (única rama no ejercitada
   por la build, admitida): un ítem de ficha sin características
   interrumpe el build, igual que la descripción. */
if (item.features === undefined) {
  throw new Error(
    `[producto] el ítem de ficha "${item.slug}" no tiene características en el catálogo.`,
  );
}

const features = item.features;
const mediaIds = item.media ?? [];
const kindById = new Map(mediaRegistry.map((entry) => [entry.id, entry.kind]));

/* T8B (F-1): la galería son los medios 1..n; hoy todos son vídeos en
   esa posición. Guard defensivo (única rama no ejercitada por la build,
   admitida por la orden): un medio de galería que no sea vídeo
   interrumpe el build, igual que haría VideoSlot. */
const galleryIds = mediaIds.slice(1);
if (galleryIds.some((id) => kindById.get(id) !== 'video')) {
  throw new Error('product gallery: only video media supported');
}

const crumbs = [
  { label: 'Inicio', href: '/' },
  { label: 'Catálogo', href: '/catalogo/' },
  { label: category.name, href: `/catalogo/${category.slug}/` },
  { label: item.name },
];
---

<BaseLayout title={`${item.name} — Lumina Home`} description={description}>
  <section class="product-hero">
    <div class="container">
      <Breadcrumbs items={crumbs} />
      <div class="product-hero-columns">
        <div class="product-hero-text">
          <h1 class="product-title">{item.name}</h1>
          <p class="product-lead">{description}</p>
        </div>
        {
          mediaIds.length > 0 && (
            <div class="product-media">
              {mediaIds.slice(0, 1).map((id) => (
                <div class="product-hero-media">
                  {kindById.get(id) === 'video' ? (
                    <VideoSlot id={id} />
                  ) : (
                    /* Brazo de imagen = medio del héroe (la única imagen del catálogo está en el índice 0): eager/high sin condicional. */
                    <MediaSlot
                      id={id}
                      widths={[480, 800, 1200]}
                      sizes="(min-width: 768px) 40vw, 100vw"
                      loading="eager"
                      fetchpriority="high"
                    />
                  )}
                </div>
              ))}
            </div>
          )
        }
        {/* T11a (ítem 2): características y CTA dentro del héroe; en móvil
            el orden de lectura es texto → medio → acciones. */}
        <div class="product-hero-actions">
          <h2 class="features-title">Características</h2>
          <ul class="features-list">
            {features.map((feature) => (
              <li class="features-item">{feature}</li>
            ))}
          </ul>
          <div class="quote-actions">
            <WhatsAppButton
              variant="on-dark"
              item={item.name}
              category={category.name}
              label="Cotizar por WhatsApp"
            />
            <a class="back-link" href={`/catalogo/${category.slug}/`}>
              Volver a {category.name}
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  {
    /* T8B (F-1): la galería va después del héroe (que ya contiene el CTA
       de cotización, T11a ítem 2) y se renderiza sin condicional: los
       dos ítems de ficha tienen 2 medios (verificado con grep en
       src/data/catalog.ts), así que siempre tiene contenido. */
  }
  <section class="product-gallery" data-reveal>
    <div class="container">
      <h2 class="gallery-title">Galería</h2>
      <div class="product-gallery-grid">
        {galleryIds.map((id) => <VideoSlot id={id} />)}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Banda de producto: azul marino con texto marfil. T11a (ítem 2): el
     héroe lleva título, entrada, medio 0, características y CTA; el
     resto de medios va en la sección "Galería", después del héroe.
     Escritorio (>= 768 px): dos columnas con áreas con nombre, el medio
     a la derecha ocupa las dos filas. */
  .product-hero {
    padding-block: var(--space-6) var(--space-7);
    background: var(--color-navy-900);
    color: var(--color-ivory);
  }

  .product-hero :global(a:focus-visible) {
    outline-color: var(--color-ivory);
  }

  .product-hero-columns {
    display: grid;
    gap: var(--space-5);
  }

  .product-media {
    display: grid;
    gap: var(--space-5);
  }

  .product-hero-media {
    margin-top: var(--space-2);
  }

  .gallery-title {
    margin-bottom: var(--space-4);
  }

  .product-media :global(.video-slot figcaption) {
    color: var(--color-cream);
  }

  .product-media :global(img) {
    /* D1 (FIX1): los atributos width/height emitidos por Astro junto con
       el max-width global dejaban la altura clavada en 1600 px mientras
       el ancho se reducía (imagen aplastada). height:auto restaura la
       proporción natural; el tope de altura recorta con cover (sin
       deformar) y mantiene el primer medio dentro del primer viewport
       en móvil. */
    width: 100%;
    height: auto;
    max-height: min(70vh, 640px);
    object-fit: cover;
    border-radius: var(--radius-md);
  }

  @media (min-width: 768px) {
    .product-hero-columns {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      grid-template-areas:
        'text media'
        'actions media';
      column-gap: var(--space-6);
      align-items: start;
    }

    .product-hero-text {
      grid-area: text;
    }

    /* T11a (ítem 2): el medio ocupa las dos filas de la derecha */
    .product-media {
      grid-area: media;
      align-self: start;
    }

    .product-hero-actions {
      grid-area: actions;
    }

    .product-hero-media {
      margin-top: 0;
    }
  }

  .product-title {
    margin-block: var(--space-3) var(--space-2);
    color: var(--color-ivory);
  }

  .product-lead {
    max-width: 60ch;
    color: var(--color-cream);
  }

  /* T11a (ítem 2): características dentro del héroe, sobre azul marino;
     la lista va en una sola columna (sin la regla de 3 columnas). */
  .features-title {
    margin-bottom: var(--space-4);
    color: var(--color-ivory);
  }

  .features-list {
    display: grid;
    gap: var(--space-3);
    padding: 0;
    margin: 0;
    list-style: none;
  }

  /* Tarjeta translúcida: tinte marfil <= 8% sobre navy-900; el texto
     marfil mantiene > 4.5:1 (verificado con la fórmula WCAG). */
  .features-item {
    padding: var(--space-3) var(--space-4);
    border: 1px solid color-mix(in srgb, var(--color-ivory) 30%, transparent);
    border-radius: var(--radius-md);
    background: color-mix(in srgb, var(--color-ivory) 8%, transparent);
    color: var(--color-ivory);
    font-weight: 600;
  }

  /* Galería de medios (T8B/F-1; T11a-FIX1/N1): rejilla
     `repeat(auto-fill, minmax(280px, 360px))`, una pista en móvil y a
     768 px, tres a 1280 px. */
  .product-gallery {
    padding-block: var(--space-6) var(--space-8);
  }

  .product-gallery-grid {
    display: grid;
    gap: var(--space-4);
  }

  @media (min-width: 768px) {
    .product-gallery-grid {
      grid-template-columns: repeat(auto-fill, minmax(280px, 360px));
      /* N-2: start evita que la figure se estire a la pista y el vídeo
         quede centrado dentro de una banda ancha (justify-items: center
         del propio VideoSlot); queda alineado bajo el título "Galería". */
      justify-items: start;
    }
  }

  /* T11a (ítem 2): el CTA usa la variante `on-dark` existente y el
     enlace de vuelta va en marfil sobre el azul marino; su anillo de
     foco viene de .product-hero :global(a:focus-visible).
     T11a-FIX1/D1: 24 px sobre la última tarjeta de características. */
  .quote-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    align-items: center;
    margin-block-start: var(--space-5);
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 600;
    color: var(--color-ivory);
    text-decoration: none;
  }

  /* T11a (ítem 9): subrayado solo con puntero fino */
  @media (hover: hover) and (pointer: fine) {
    .back-link:hover {
      text-decoration: underline;
    }
  }
</style>
