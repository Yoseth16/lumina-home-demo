---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import ItemCard from '../../../components/ItemCard.astro';
import { categories } from '../../../data/catalog';
import type { Category } from '../../../data/schema';

export function getStaticPaths() {
  return categories.map((category) => ({
    params: { categoria: category.slug },
    props: { category },
  }));
}

interface Props {
  category: Category;
}

const { category } = Astro.props;

/* T11b (ítem 4): separación de ítems para dos grupos visibles — las
   fichas completas en la rejilla y los pendientes en la lista compacta
   «Más productos — ficha en preparación», conservando el orden del
   catálogo dentro de cada grupo. */
const fichaItems = category.items.filter((item) => item.status === 'ficha');
const pendingItems = category.items.filter((item) => item.status === 'pendiente');

// Defensivo (única rama no ejercitada por la build real, G13): el grupo
// de pendientes se dibuja siempre y hoy toda categoría tiene >= 1.
if (pendingItems.length === 0) {
  throw new Error(
    `Categoría "${category.slug}": el grupo de pendientes necesita al menos un ítem pendiente.`,
  );
}

const crumbs = [
  { label: 'Inicio', href: '/' },
  { label: 'Catálogo', href: '/catalogo/' },
  { label: category.name },
];
---

<BaseLayout title={`${category.name} — Lumina Home`} description={category.tagline}>
  <section class="category-hero">
    <div class="container">
      <Breadcrumbs items={crumbs} />
      <h1 class="category-title">{category.name}</h1>
      <p class="category-lead">{category.tagline}</p>
    </div>
  </section>

  <nav class="category-switcher" aria-label="Categorías">
    <div class="container">
      <ul class="switcher-list">
        {
          categories.map((cat) => (
            <li>
              <a
                class="switcher-link"
                href={`/catalogo/${cat.slug}/`}
                aria-current={cat.slug === category.slug ? 'page' : undefined}
              >
                {cat.shortName}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </nav>

  <script>
    const list = document.querySelector<HTMLElement>('.switcher-list');
    const active = list?.querySelector<HTMLElement>('[aria-current="page"]');
    if (list && active) {
      const overflow = active.offsetLeft - list.offsetLeft + active.offsetWidth - list.clientWidth;
      if (overflow > 0) {
        list.scrollLeft = overflow;
      }
    }
  </script>

  <section class="items-section" data-reveal>
    <div class="container">
      {
        fichaItems.length > 0 && (
          <>
            <h2 class="visually-hidden">Productos de {category.name}</h2>
            <div class="items-grid">
              {fichaItems.map((item) => (
                <ItemCard category={category} item={item} />
              ))}
            </div>
          </>
        )
      }
      <div class="pending-group">
        <h2 class="pending-title">
          {fichaItems.length > 0 ? 'Más productos — ficha en preparación' : 'Productos — ficha en preparación'}
        </h2>
        <ul class="pending-list" role="list">
          {
            pendingItems.map((item) => (
              <li>
                <ItemCard category={category} item={item} />
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Banda de categoría: azul marino con texto marfil, sin CTAs ni imágenes */
  .category-hero {
    padding-block: var(--space-6) var(--space-7);
    background: var(--color-navy-900);
    color: var(--color-ivory);
  }

  .category-hero :global(a:focus-visible) {
    outline-color: var(--color-ivory);
  }

  .category-title {
    margin-block: var(--space-3) var(--space-2);
    color: var(--color-ivory);
  }

  .category-lead {
    max-width: 46ch;
    color: var(--color-cream);
  }

  /* Conmutador de categorías: FX-13 — una sola fila con desplazamiento
     horizontal y scroll-snap en móvil (sin salto de línea ni scroll de
     página), alineada al borde del contenedor en escritorio. */
  .category-switcher {
    border-bottom: 1px solid var(--color-line);
    background: var(--color-cream);
  }

  .switcher-list {
    display: flex;
    flex-wrap: nowrap;
    gap: var(--space-1);
    /* D3 (FIX1): el padding-inline UA (40px) desalineaba la primera
       pestaña respecto al borde del contenedor/h1; a cero alinea la
       caja de la pestaña con el borde. */
    padding-inline: 0;
    padding-block: var(--space-2);
    margin: 0;
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x proximity;
    -webkit-overflow-scrolling: touch;
  }

  .switcher-list li {
    flex: 0 0 auto;
    scroll-snap-align: start;
  }

  .switcher-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-inline: var(--space-3);
    border-radius: var(--radius-sm);
    color: var(--color-muted);
    text-decoration: none;
  }

  /* T11a (ítem 9): subrayado solo con puntero fino */
  @media (hover: hover) and (pointer: fine) {
    .switcher-link:hover {
      text-decoration: underline;
    }
  }

  .switcher-link[aria-current='page'] {
    font-weight: 600;
    color: var(--color-navy-800);
    background: var(--color-ivory);
    box-shadow: inset 0 -2px 0 var(--color-navy-800);
  }

  /* Productos: una columna en móvil, dos a partir de 640 px, tres a partir de 1000 px.
     D5 (FIX1): align-items start evita que las tarjetas pendientes se
     estiren a la altura de la tarjeta ficha con miniatura. */
  .items-section {
    padding-block: var(--space-6) var(--space-8);
  }

  .items-grid {
    display: grid;
    gap: var(--space-4);
    align-items: start;
  }

  @media (min-width: 640px) {
    .items-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1000px) {
    .items-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* T11b (ítem 4): grupo de pendientes en filas compactas; el margen
     superior solo existe cuando sigue a la rejilla de fichas (selector
     de hermanos, sin condicional de plantilla). */
  .items-grid + .pending-group {
    margin-top: var(--space-7);
  }

  .pending-title {
    font-size: var(--fs-2);
    color: var(--color-navy-800);
    margin-bottom: var(--space-4);
  }

  /* role="list" compensa el workaround de semántica de lista de
     Safari/VoiceOver con `list-style: none`. */
  .pending-list {
    display: grid;
    gap: var(--space-3);
    padding: 0;
    list-style: none;
  }

  @media (min-width: 768px) {
    .pending-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
