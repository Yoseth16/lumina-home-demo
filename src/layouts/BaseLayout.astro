---
import '@fontsource-variable/manrope';
import '@fontsource/cormorant-garamond/500.css';
import '@fontsource/cormorant-garamond/600.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FloatingWhatsApp from '../components/FloatingWhatsApp.astro';
import DemoRibbon from '../components/DemoRibbon.astro';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { mediaRegistry } from '../data/media';
import { site } from '../data/site';
import { withBase, resolveAbsoluteUrl } from '../lib/paths';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

/* T11a (ítem 1): el botón flotante va en todas las páginas salvo
   contacto, que ya es el canal de cotización (con trailingSlash
   'always' la ruta es '/contacto/'). Ambos brazos quedan ejercitados
   por la build real: las 8 páginas restantes lo renderizan y contacto
   no. T14: la ruta se resuelve con la base del despliegue para que la
   comparación funcione igual en la raíz y en el subdirectorio de
   GitHub Pages. */
const showFloatingWhatsApp = !Astro.url.pathname.startsWith(withBase('/contacto/'));

/* T13 (ítem 4): imagen de vista previa para Open Graph derivada del
   registro (foto de obra de persianas), igual que `MediaSlot.astro`;
   se emite en las 9 páginas. Defensivas (únicas ramas no ejercitadas
   por la build real): id no registrado o archivo faltante, sin
   ternarios ni cortocircuitos (T13-FIX1, hallazgo 1). */
const imageSources = import.meta.glob('/src/assets/**/*.{jpeg,jpg,png}', {
  eager: true,
  import: 'default',
}) as Record<string, ImageMetadata>;

const ogEntry = mediaRegistry.find((candidate) => candidate.id === 'obra-enrollable-doble-altura');
if (ogEntry === undefined) {
  throw new Error('BaseLayout: medio de vista previa no disponible: "obra-enrollable-doble-altura".');
}
const ogSource = imageSources[`/${ogEntry.file}`];
if (ogSource === undefined) {
  throw new Error('BaseLayout: archivo de vista previa no disponible: "obra-enrollable-doble-altura".');
}

const ogImage = await getImage({ src: ogSource, width: 1200, format: 'jpeg' });
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#F1E9DC" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {
      site.indexable === false && (
        <meta name="robots" content="noindex, nofollow" />
      )
    }
    {
      site.siteUrl !== undefined && (
        <link rel="canonical" href={new URL(Astro.url.pathname, site.siteUrl).href} />
      )
    }
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={resolveAbsoluteUrl(ogImage.src, site.siteUrl)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:site_name" content={site.name} />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
  </head>
  <body class={showFloatingWhatsApp ? 'has-fab' : undefined}>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <DemoRibbon />
    <Header />
    <main id="contenido" tabindex="-1">
      <slot />
    </main>
    <Footer />
    {showFloatingWhatsApp && <FloatingWhatsApp />}
    <script>
      import '../scripts/reveal.ts';
    </script>
  </body>
</html>
